# CropFresh Environment Variables (copy to .env if customizing)
# Optional: URL of remote GPU Big Vision JAX microservice running cropfresh_model/paligemma2_jax_service.py
PALIGEMMA_INFERENCE_URL=
# Optional: path to base google/paligemma-2/jax/paligemma2-3b-pt-224 (.npz ~6.1 GB) for local JAX inference
PALIGEMMA_BASE_MODEL_PATH=
# Optional: path to extracted CropFresh_PaliGemma_T4x2 artifacts directory
PALIGEMMA_ARTIFACTS_DIR=
# Optional: path to Firebase Admin service account JSON for live Firestore + Firebase Auth
# When omitted or missing, backend uses local persistent Firestore fallback (backend/data/local_firestore.json)
FIREBASE_SERVICE_ACCOUNT_PATH=
CROPFRESH_JWT_SECRET=cropfresh-local-dev-secret-2026
PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
